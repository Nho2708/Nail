# PostgreSQL connection string (Neon: Dashboard → Connect → pooled connection)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Salon time zone ("today", opening hours, daily stats)
TZ=Asia/Ho_Chi_Minh

# First admin account — only used when the database has no admin yet.
# If ADMIN_PASSWORD is empty a random password is generated and printed once in the log.
ADMIN_EMAIL=admin@nail.local
ADMIN_PASSWORD=

PORT=3000
# NODE_ENV=production   # set on the host (HTTPS) so the login cookie is Secure
